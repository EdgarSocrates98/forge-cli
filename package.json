{
  "name": "forge-cli",
  "version": "0.1.0",
  "description": "CLI interativa para clonar e configurar o ecossistema Forge",
  "type": "module",
  "bin": {
    "forge-cli": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "execa": "^9.0.0",
    "figlet": "^1.9.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
